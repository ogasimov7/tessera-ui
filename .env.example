# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Stripe Price IDs. When unset, prices are created inline from the amounts in lib/plans.ts
STRIPE_PRICE_BASE=
STRIPE_PRICE_CUSTOM=

# Postgres (Neon, Supabase, RDS, local...)
DATABASE_URL=postgres://user:pass@localhost:5432/tessera

# Public URL used for Stripe redirects and by the Figma plugin to look up codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Figma Community plugin (see figma/README in the download). The id comes from Figma when you create the plugin;
# the URL is its Community page, linked from the buyer's figma/README.md once published.
FIGMA_PLUGIN_ID=
NEXT_PUBLIC_FIGMA_PLUGIN_URL=
